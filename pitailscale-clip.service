[Unit]
Description=PiTailscale PickClip — customer-facing clip SPA
After=network-online.target pitailscale-recorder.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PT_DATA_DIR=__INSTALL_DIR__/data
Environment=PT_CLIP_PORT=__CLIP_PORT__
ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/clipapp.py --host 0.0.0.0 --port __CLIP_PORT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
