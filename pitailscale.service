[Unit]
Description=PiTailscale — LAN camera discovery & Tailscale forwarder
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PT_DATA_DIR=__INSTALL_DIR__/data
Environment=PT_PORT=__PORT__
ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/app.py --host 0.0.0.0 --port __PORT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
