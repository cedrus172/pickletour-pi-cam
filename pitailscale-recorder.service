[Unit]
Description=PiTailscale Recorder — Dahua live/playback/clip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PT_DATA_DIR=__INSTALL_DIR__/data
Environment=PT_RECORDER_PORT=__RECORDER_PORT__
ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/recorder.py --host 0.0.0.0 --port __RECORDER_PORT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
