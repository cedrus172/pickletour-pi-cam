[Unit]
Description=PiTailscale Hub — quản lý tất cả sân (Pi + DDNS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PT_DATA_DIR=__INSTALL_DIR__/data
Environment=PT_HUB_PORT=__HUB_PORT__
Environment=PT_RECORDER_PORT=__RECORDER_PORT__
Environment=PT_CLIP_PORT=__CLIP_PORT__
ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/hub.py --host 0.0.0.0 --port __HUB_PORT__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
